{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bridge-stat",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"env": {
		"production": {
			"vars": {
				"BETTER_AUTH_URL": "https://bridge-stat.timothyrmarriott.workers.dev",
				"VITE_BASE_URL": "https://bridge-stat.timothyrmarriott.workers.dev",
				"DISCORD_CLIENT_ID": "1474721729896255569"
			}
		}
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "bridge",
			"database_name": "bridge",
			"database_id": "dd6d112b-d5eb-4207-be42-2b6b722865b3",
			"migrations_dir": "drizzle"
		}
	],
	"vars": {
		"BETTER_AUTH_URL": "https://bridge-stat.timothyrmarriott.workers.dev",
		"DISCORD_CLIENT_ID": "1474721729896255569",
		"VITE_BASE_URL": "https://bridge-stat.timothyrmarriott.workers.dev"
	}
}